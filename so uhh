local selectedMob = "Bandit"
getgenv().AutoFarm = false
getgenv().AutoBoss = false
getgenv().AutoSeaEvents = false
getgenv().AutoStoreFruit = false

-- Funções básicas

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- Função para iniciar quest
function StartQuest()
    local questData = npcList[selectedMob]
    if not questData then return end
    local args = {
        [1] = "StartQuest",
        [2] = questData[1],
        [3] = 1
    }
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer(unpack(args))
    end)
end

-- Função para pegar inimigo mais próximo do tipo selecionado
function GetClosestMob()
    local dist = math.huge
    local closest = nil
    for _, mob in pairs(Workspace.Enemies:GetChildren()) do
        if mob.Name == npcList[selectedMob][2] and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
            local mag = (mob.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if mag < dist then
                closest = mob
                dist = mag
            end
        end
    end
    return closest
end

-- Função de ataque simples (clique)
function Attack()
    VirtualInputManager:SendMouseButtonEvent(0,0,0,true,game,1)
    task.wait(0.1)
    VirtualInputManager:SendMouseButtonEvent(0,0,0,false,game,1)
end

-- Função de teleporte
function TeleportTo(cframe)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = cframe
    end
end

-- Loop principal do AutoFarm
coroutine.wrap(function()
    while true do
        task.wait(0.1)
        if getgenv().AutoFarm then
            pcall(function()
                StartQuest()
                local mob = GetClosestMob()
                if mob then
                    while mob and mob.Humanoid.Health > 0 and getgenv().AutoFarm do
                        TeleportTo(mob.HumanoidRootPart.CFrame * CFrame.new(0,15,0))
                        Attack()
                        task.wait(0.2)
                    end
                else
                    StartQuest()
                    task.wait(2)
                end
            end)
        else
            task.wait(1)
        end
    end
end)()

